      "id": "2",
      "name": "AI Evaluation Demo",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -480,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const x = $input.first().json;\n\n// Normalize evaluator outputs into boolean signals.\nconst A = x.brandFit === true || x.brandFit === 'true';\nconst B = x.platformFit === true || x.platformFit === 'true';\nconst S = x.safetyPass === true || x.safetyPass === 'true';\n\nreturn [{\n  json: {\n    ...x,\n    signals: { brandFit: A, platformFit: B, safetyPass: S },\n    evaluationVersion: 'v1'\n  }\n}];"
      },
      "id": "3",
      "name": "Normalize AI Signals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const x = $input.first().json;\nconst audit = x.bai_audit || {};\nconst hasEvidence = Array.isArray(audit.evidence_refs) && audit.evidence_refs.length > 0;\nconst gatePass = audit.gate_pass === true && audit.human_review_required !== true && hasEvidence;\nreturn [{\n  json: {\n    ...x,\n    bai: {\n      gate_pass: gatePass,\n      evidence_present: hasEvidence,\n      source_gate_pass: audit.gate_pass === true,\n      human_review_required: audit.human_review_required === true\n    },\n    baiDecision: gatePass ? 'BAI_PASS' : 'BAI_REVIEW'\n  }\n}];"
      },
      "id": "3b",
      "name": "BAI Fairness Pre-Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -100,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "const x = $input.first().json;\nconst { brandFit: A, platformFit: B, safetyPass: S } = x.signals;\nconst F = x.bai?.gate_pass === true;\n\n// Digital analogue: BAI fairness pre-gate + safety interlock + OR gate.\n// Relevance and safety are insufficient when the fairness evidence gate fails.\nconst relevance = A || B;\nconst approved = F && S && relevance;\n\nreturn [{\n  json: {\n    ...x,\n    logic: { formula: 'F AND S AND (A OR B)', F, A, B, S, relevance, approved },\n    route: approved ? 'AUTO_PUBLISH' : 'HUMAN_REVIEW',\n    decisionReason: approved ? 'bai_safety_and_relevance_passed' : 'bai_safety_or_relevance_failed'\n  }\n}];"
      },
      "id": "4",
      "name": "Safety Interlock Logic Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "approved",
              "leftValue": "={{ $json.logic.approved }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
