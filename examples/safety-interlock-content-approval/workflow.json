      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-720, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {"id": "content", "name": "content", "value": "مسودة منشور عن فوائد أتمتة المحتوى باستخدام n8n.", "type": "string"},
            {"id": "brandFit", "name": "brandFit", "value": "true", "type": "boolean"},
            {"id": "platformFit", "name": "platformFit", "value": "false", "type": "boolean"},
            {"id": "safetyPass", "name": "safetyPass", "value": "true", "type": "boolean"},
            {"id": "contentId", "name": "contentId", "value": "demo-content-001", "type": "string"}
          ]
        },
        "options": {}
      },
      "id": "2",
      "name": "AI Evaluation Demo",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-480, 0]
    },
    {
      "parameters": {
        "jsCode": "const x = $input.first().json;\n\n// Normalize evaluator outputs into boolean signals.\nconst A = x.brandFit === true || x.brandFit === 'true';\nconst B = x.platformFit === true || x.platformFit === 'true';\nconst S = x.safetyPass === true || x.safetyPass === 'true';\n\nreturn [{\n  json: {\n    ...x,\n    signals: { brandFit: A, platformFit: B, safetyPass: S },\n    evaluationVersion: 'v1'\n  }\n}];"
      },
      "id": "3",
      "name": "Normalize AI Signals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-240, 0]
    },
    {
      "parameters": {
        "jsCode": "const x = $input.first().json;\nconst { brandFit: A, platformFit: B, safetyPass: S } = x.signals;\n\n// Digital analogue: safety interlock + OR gate.\n// A or B can establish relevance, but safety S is mandatory.\nconst relevance = A || B;\nconst approved = S && relevance;\n\nreturn [{\n  json: {\n    ...x,\n    logic: { formula: 'S AND (A OR B)', A, B, S, relevance, approved },\n    route: approved ? 'AUTO_PUBLISH' : 'HUMAN_REVIEW',\n    decisionReason: approved ? 'safety_passed_and_relevance_passed' : 'mandatory_safety_or_relevance_failed'\n  }\n}];"
      },
      "id": "4",
      "name": "Safety Interlock Logic Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [20, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2},
          "conditions": [
            {"id": "approved", "leftValue": "={{ $json.logic.approved }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true", "singleValue": true}}
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5",
      "name": "IF Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [280, 0]
    },
    {
      "parameters": {
        "assignments": {"assignments": [{"id": "action", "name": "action", "value": "PUBLISH_OR_QUEUE", "type": "string"}]},
        "options": {}
      },
